PORT=5001
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/shopkart
JWT_SECRET=any_long_random_text

# Razorpay TEST MODE keys (Dashboard -> Account & Settings -> API Keys)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# optional: lets you move orders PLACED -> CONFIRMED -> SHIPPED -> DELIVERED (header x-admin-key)
ADMIN_KEY=choose_any_secret_text
